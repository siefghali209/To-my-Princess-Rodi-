<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>For Rody ❤️</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      min-height: 100vh;
      font-family: "Tahoma", sans-serif;
      background:
        radial-gradient(circle at top, #3b2730 0%, #191317 45%, #0d0b0d 100%);
      color: #fff;
      display: flex;
      justify-content: center;
      align-items: center;
      overflow: hidden;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background:
        radial-gradient(circle, rgba(255,255,255,.06) 1px, transparent 1px);
      background-size: 35px 35px;
      opacity: .35;
      pointer-events: none;
    }

    .container {
      width: 90%;
      max-width: 430px;
      position: relative;
      z-index: 2;
    }

    .card {
      background: rgba(255,255,255,.07);
      border: 1px solid rgba(255,255,255,.12);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border-radius: 28px;
      padding: 38px 25px;
      text-align: center;
      box-shadow: 0 20px 70px rgba(0,0,0,.45);
      animation: appear .9s ease;
    }

    .heart {
      font-size: 55px;
      margin-bottom: 18px;
      animation: heartbeat 2s infinite;
    }

    h1 {
      font-size: 25px;
      margin-bottom: 12px;
    }

    .subtitle {
      color: #d9cfd2;
      font-size: 15px;
      line-height: 1.8;
      margin-bottom: 28px;
    }

    input {
      width: 100%;
      padding: 15px;
      border-radius: 15px;
      border: 1px solid rgba(255,255,255,.15);
      outline: none;
      background: rgba(0,0,0,.25);
      color: white;
      text-align: center;
      font-size: 18px;
      margin-bottom: 15px;
    }

    input::placeholder {
      color: #aaa;
    }

    button {
      width: 100%;
      border: none;
      padding: 15px;
      border-radius: 15px;
      background: #d58b9e;
      color: white;
      font-size: 17px;
      font-weight: bold;
      cursor: pointer;
      transition: .25s;
    }

    button:hover {
      transform: translateY(-2px);
      background: #e39aad;
    }

    .error {
      height: 22px;
      margin-top: 12px;
      color: #e7a7b7;
      font-size: 13px;
    }

    #main {
      display: none;
    }

    .message {
      line-height: 2.1;
      color: #eee;
      font-size: 16px;
      margin-top: 18px;
    }

    .message strong {
      color: #e7a7b7;
    }

    .divider {
      width: 55px;
      height: 1px;
      background: rgba(255,255,255,.25);
      margin: 25px auto;
    }

    .song {
      margin-top: 25px;
      padding: 18px;
      border-radius: 18px;
      background: rgba(0,0,0,.18);
    }

    .song-title {
      font-size: 13px;
      color: #c9b8bd;
      margin-bottom: 8px;
    }

    .song-line {
      font-size: 17px;
      line-height: 2;
      color: #fff;
    }

    .small {
      margin-top: 25px;
      color: #aaa;
      font-size: 12px;
    }

    .fade {
      animation: fadeIn 1.2s ease forwards;
    }

    @keyframes appear {
      from {
        opacity: 0;
        transform: translateY(25px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }

    @keyframes heartbeat {
      0%, 100% {
        transform: scale(1);
      }
      50% {
        transform: scale(1.08);
      }
    }
  </style>
</head>

<body>

  <div class="container">

    <!-- PASSWORD -->
    <div class="card" id="login">

      <div class="heart">❤️</div>

      <h1>رودي...</h1>

      <div class="subtitle">
        قبل ما تدخلي،<br>
        في حاجة صغيرة عايز أقولهالك.
      </div>

      <input
        id="password"
        type="password"
        inputmode="numeric"
        placeholder="اكتبي الباسورد"
        maxlength="3"
      >

      <button onclick="checkPassword()">
        ادخلي ❤️
      </button>

      <div class="error" id="error"></div>

    </div>


    <!-- MAIN PAGE -->
    <div class="card" id="main">

      <div class="heart">🤍</div>

      <h1>رودي...</h1>

      <div class="message fade">

        <p>
          أنا مش عامل الموقع ده عشان أقول كلام كتير،
          ولا عشان أضغط عليكي في حاجة.
        </p>

        <div class="divider"></div>

        <p>
          بس يمكن أوقات الكلام في الشات
          مبيعرفش يوصل اللي جوانا صح.
        </p>

        <br>

        <p>
          وأنا كل اللي عايزه...
          <strong>إننا نرجع كويسين.</strong>
        </p>

        <br>

        <p>
          يمكن غلطنا، يمكن اتخانقنا،
          ويمكن كل واحد فينا زعل من التاني...
          بس أنا مش عايز الزعل ده يبقى آخر حاجة بينا.
        </p>

        <div class="song">

          <div class="song-title">
            ومن أغنية بتقول اللي جوايا...
          </div>

          <div class="song-line">
            🎵 أنا حالف ما نتفارق...
            أنا حالف لَأكون عاشق 🎵
          </div>

        </div>

        <p class="small">
          مش طالب غير إنك تسمعيني ❤️
        </p>

      </div>

    </div>

  </div>


  <script>

    function checkPassword() {

      const password = document.getElementById("password").value;
      const error = document.getElementById("error");

      if (password === "209") {

        document.getElementById("login").style.display = "none";
        document.getElementById("main").style.display = "block";

      } else {

        error.textContent = "لأ يا رودي 😂 حاولي تاني ❤️";

        document.getElementById("password").value = "";

      }
    }


    document.getElementById("password").addEventListener("keypress", function(event) {

      if (event.key === "Enter") {
        checkPassword();
      }

    });

  </script>

</body>
</html>
